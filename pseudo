while decl

decl:
	let tok = next()
	let decl = new decl

	if tok is EOF:
		return 0

	if tok is "extern":
		tok = next()
		decl.type = EXTERN
	else if tok is "auto":
		tok = next()
		decl.type = AUTO
	else:
		decl.type = STATIC

	if tok is "(":
		func()
		return 1

	loop:
		decl.name = tok.string
		tok = next()

		if tok is NOT ",":
			break

	if tok is "=":
		tok = next()
		decl.initial = cons() // constant expression
		output(decl)

	tok = next() // semicolon
	return 2
